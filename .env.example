# Development only. Copy to .env; never commit actual credentials.
DATABASE_URL=postgresql://enarm_app:local-development-only@127.0.0.1:55439/enarm_test
DATABASE_ADMIN_URL=postgresql://enarm_local@127.0.0.1:55439/enarm_test
APP_DB_PASSWORD=local-development-only
WORKER_DB_PASSWORD=local-development-only
POC_ACCESS_MODE=private
POC_PASSWORD=replace-with-your-own-local-password
PORT=3000
SERVICE_ROLE=app
S3_ENDPOINT=https://your-s3-endpoint.test
S3_REGION=auto
S3_BUCKET=your-own-bucket
S3_ACCESS_KEY_ID=replace
S3_SECRET_ACCESS_KEY=replace

# Worker only. Own ENARM credential; never reuse another project's key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
# Shared daily request limit (app service).
GENERATION_DAILY_LIMIT=30

# Alternative provider: OpenRouter. Takes precedence over the direct OpenAI key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.4-mini
OPENROUTER_REVIEW_MODEL=openai/gpt-5.4
OPENROUTER_SERIES_MODEL=openai/gpt-5.4
